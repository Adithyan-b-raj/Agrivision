# Google OAuth 2.0 Environment Keys Template
# 1. Obtain from https://console.cloud.google.com/apis/credentials
# 2. Add http://localhost:8000 as Authorized redirect URI in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000


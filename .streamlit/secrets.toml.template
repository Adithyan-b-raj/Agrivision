# Google OAuth 2.0 Credentials for AgriVision AI
# Step 1: Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Step 2: Click "Create Credentials" -> "OAuth client ID"
# Step 3: Application type -> "Web application"
# Step 4: Add Authorized redirect URI -> "http://localhost:8501"
# Step 5: Copy your Client ID and Client Secret below:

google_client_id = "YOUR_CLIENT_ID_HERE.apps.googleusercontent.com"
google_client_secret = "YOUR_CLIENT_SECRET_HERE"
redirect_uri = "http://localhost:8501"
